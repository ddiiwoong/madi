<Project Sdk="Microsoft.NET.Sdk">

  <!-- 껍데기의 파일 로직(DiskBaseline · AtomicFile · LaunchOptions) 시험. Windows에서만 돈다(CI). 편집기의 로직은 ../editor의 Node 시험. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit v3의 시험 프로젝트는 그 자체로 실행 파일이다 — `dotnet run`으로 돌린다(.NET 10의 `dotnet test`는 예전 VSTest 길을 받지 않는다). -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Madi.Windows\Madi.Windows.csproj" />
  </ItemGroup>

</Project>
